msgstr "Aufwecken des AV-Receivers beim Aktivieren von Kodi erzwingen"

msgctxt "#36047"
msgid "Remote button press delay before repeating (ms)"
msgstr "Wiederholungsverzögerung für Fernbedienungstasten (ms)"

msgctxt "#36048"
